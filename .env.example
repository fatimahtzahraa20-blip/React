VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional PUBLIC demo account overrides. These values are visible in browser code.
# Never put real staff credentials here. Create matching test accounts in Supabase.
# Autofill is enabled in local development; production requires explicit opt-in.
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_ADMIN_EMAIL=Main@gmail.com
VITE_DEMO_ADMIN_PASSWORD=admin123!
VITE_DEMO_HOD_EMAIL=hod@example.test
VITE_DEMO_HOD_PASSWORD=DemoHod123!
VITE_DEMO_COORDINATOR_EMAIL=coordinator@example.test
VITE_DEMO_COORDINATOR_PASSWORD=DemoCoordinator123!
VITE_DEMO_LECTURER_EMAIL=lecturer@example.test
VITE_DEMO_LECTURER_PASSWORD=DemoLecturer123!
