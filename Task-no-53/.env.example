# Public browser config. You can also enter these in Connection settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Server secrets: deploy using supabase secrets set --env-file .env
# Never prefix these with VITE_.
RESEND_API_KEY=re_YOUR_KEY
EMAIL_FROM=Acme <hello@YOUR_VERIFIED_DOMAIN>
WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
